# ═══════════════════════════════════════════════════════════════════════════
#  Legal AI System — Environment Configuration
#  Copy this file to .env and fill in your API key.
# ═══════════════════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Default: gemini  (free tier, no credit card, starts in ~30 seconds)
# Options: gemini | ollama | openai | anthropic
LLM_PROVIDER=gemini

# ── Gemini (DEFAULT — free tier) ─────────────────────────────────────────────
# Get a free API key in 30 seconds at: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1M tokens/day — more than enough for evaluation
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TEXT_MODEL=gemini-1.5-flash

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_TEXT_MODEL=gpt-4o

# ── Anthropic (optional) ─────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here

# ── Ollama / local models (optional — requires ~5GB download) ────────────────
# LLM_PROVIDER=ollama
# Run with: docker compose --profile ollama up -d
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_VISION_MODEL=qwen2.5vl:3b
# OLLAMA_TEXT_MODEL=qwen2.5:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ── ChromaDB (no changes needed) ─────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
